{
  "name": "suipad",
  "version": "0.1.0",
  "description": "SuiPad — a Telegram bot that trades tokens and launches new coins on the Sui blockchain.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "build:template": "tsx scripts/build-coin-template.ts",
    "set-webhook": "tsx scripts/set-webhook.ts"
  },
  "dependencies": {
    "@cetusprotocol/aggregator-sdk": "^0.11.0",
    "@mysten/bcs": "^1.6.0",
    "@mysten/move-bytecode-template": "^0.2.0",
    "@mysten/sui": "^1.45.2",
    "@upstash/redis": "^1.38.4",
    "bn.js": "^5.2.1",
    "dotenv": "^16.4.5",
    "grammy": "^1.46.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
