# ============================================================================
# SuiPad configuration. Copy to `.env` and fill in. NEVER commit your real .env.
# ============================================================================

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# The bot is PUBLIC by default (anyone can use it). To make it private, set
# ENFORCE_ALLOWLIST=true and list the allowed numeric IDs in ALLOWED_TELEGRAM_IDS.
ENFORCE_ALLOWLIST=
# Comma-separated numeric IDs allowed to use the bot (only when ENFORCE_ALLOWLIST=true).
ALLOWED_TELEGRAM_IDS=
# Comma-separated admin IDs (bans, ops).
ADMIN_TELEGRAM_IDS=

# --- Multi-chain RPCs (optional; public defaults are used when blank) --------
SOLANA_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
BSC_RPC_URL=

# --- Sui network ------------------------------------------------------------
# mainnet | testnet | devnet | localnet | custom
SUI_NETWORK=testnet
# RPC URL. Public *.sui.io fullnodes deprecated JSON-RPC; defaults point at
# JSON-RPC-compatible providers. Use your own node/provider for mainnet.
SUI_RPC_URL=

# --- Wallet security --------------------------------------------------------
# 32+ byte key that encrypts every stored private key.  openssl rand -hex 32
WALLET_ENCRYPTION_KEY=

# --- Trading / routing ------------------------------------------------------
# mock (offline dev) | cetus (live Cetus DEX aggregator, mainnet)
SWAP_PROVIDER=mock
SWAP_API_BASE_URL=
DEFAULT_SLIPPAGE_BPS=100

# --- Fees & referrals -------------------------------------------------------
# Fee actually charged (110 = 1.1%) vs displayed to users (100 = 1%).
TRADING_FEE_BPS=110
DISPLAY_FEE_BPS=100
# Where collected fees are sent (a wallet you control).
FEE_WALLET_ADDRESS=
# Secret key of the fee wallet (suiprivkey… or hex). Enables on-chain referral
# payouts via /referral → Claim. Leave blank to keep payouts manual (ledger only).
FEE_WALLET_SECRET=
# Minimum claimable referral balance in SUI (covers gas; avoids dust claims).
MIN_REFERRAL_CLAIM_SUI=0.05
# Referral share of the fee per level L1..L5 (bps): 20% / 5% / 2% / 2% / 1%.
REFERRAL_LEVEL_BPS=2000,500,200,200,100

# --- Storage (Upstash Redis for Vercel; file fallback locally) --------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DATA_FILE=./data/suipad.json

# --- Token launch / launchpad ----------------------------------------------
# Compiler-free coin launch template (see scripts/build-coin-template.ts).
COIN_TEMPLATE_PATH=
# Sui CLI path (used if COIN_TEMPLATE_PATH is not set).
SUI_CLI_PATH=
# Deployed bonding-curve launchpad package (see move/launchpad). Enables /launch curve trading.
LAUNCHPAD_PACKAGE_ID=
LAUNCHPAD_CONFIG_ID=

# --- Bridging ---------------------------------------------------------------
# mock | mayan | debridge
BRIDGE_PROVIDER=mock
BRIDGE_API_BASE_URL=

# --- Security / limits ------------------------------------------------------
RATE_LIMIT_PER_MIN=30
MAX_BUY_SUI=0           # 0 = no cap
MAX_SUBWALLETS=10

# --- Hosting (Vercel) -------------------------------------------------------
PUBLIC_URL=             # https://your-app.vercel.app
WEBHOOK_SECRET=         # random string; validates incoming webhook calls
CRON_SECRET=            # protects /api/cron

LOG_LEVEL=info
