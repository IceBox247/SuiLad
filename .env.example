# ============================================================================
# SuiPad configuration. Copy to `.env` and fill in. NEVER commit your real .env.
# ============================================================================

# --- Telegram ---------------------------------------------------------------
# Get this from @BotFather on Telegram (https://t.me/BotFather -> /newbot).
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated Telegram numeric user IDs allowed to use the bot.
# Leave blank to allow everyone. Use @userinfobot to find your ID.
ALLOWED_TELEGRAM_IDS=

# --- Sui network ------------------------------------------------------------
# One of: mainnet | testnet | devnet | localnet | custom
SUI_NETWORK=testnet

# Full node RPC URL. Public Sui fullnodes have deprecated some JSON-RPC methods,
# so for mainnet you should point this at your own node or a dedicated RPC
# provider. When SUI_NETWORK is testnet/devnet the default public URL is used
# if this is left blank.
SUI_RPC_URL=

# --- Wallet security --------------------------------------------------------
# 32-byte key used to encrypt every stored user private key (AES-256-GCM).
# Generate one with:  openssl rand -hex 32
# If you lose this, every stored wallet becomes unrecoverable.
WALLET_ENCRYPTION_KEY=

# --- Trading ----------------------------------------------------------------
# Swap routing provider: mock | sevenk | cetus
# - mock    : no network, deterministic quotes (use for local testing/dev)
# - sevenk  : 7k aggregator REST API (https://api.7k.ag)
# - cetus   : Cetus aggregator REST API
SWAP_PROVIDER=mock

# Base URL for the selected HTTP aggregator (only used by sevenk/cetus).
SWAP_API_BASE_URL=

# Default slippage tolerance in basis points (100 = 1%).
DEFAULT_SLIPPAGE_BPS=100

# Optional fee taken by the bot operator on each swap, in basis points.
# Requires PLATFORM_FEE_ADDRESS to be set. 0 disables the fee.
PLATFORM_FEE_BPS=0
PLATFORM_FEE_ADDRESS=

# --- Storage ----------------------------------------------------------------
# Path to the JSON data file (created automatically).
DATA_FILE=./data/suipad.json

# --- Token launching --------------------------------------------------------
# Compiler-free launching: path to a file holding the base64 of the compiled
# reference coin template. Generate it once with:
#   npx tsx scripts/build-coin-template.ts   (requires the Sui CLI)
# If set, launches patch this template — no Sui CLI needed at runtime.
COIN_TEMPLATE_PATH=

# Compile-based launching: path/command for the Sui CLI. Used when
# COIN_TEMPLATE_PATH is not set. Defaults to `sui` on PATH.
SUI_CLI_PATH=

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=info
